encryption = "age"
[age]
identity = "{{ .chezmoi.homeDir }}/.config/age/chezmoi.key"
recipients = [
  "age1kgtfylpyecwy28svj5gkgpt5mxva4l5eypt8dswutxtec7e59qvsj6xtzv",
  "age1qyheg2r82v0g7p5j28flggwg930yfur0mq3y7lv2j3j4tglz5emsnk8ygz",
]

[edit]
command = "nvim"

[diff]
command = "delta"

{{- /* Guess the machine type; asked once, then remembered. Choices must match [packages.machines]. */}}
{{- $machine := "lindev" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $machine = "mac" }}
{{- else if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{-   $machine = "wsl" }}
{{- end }}
{{- $machine = promptChoiceOnce . "machine" "Machine type" (list "lindev" "mac" "wsl") $machine }}
[data]
machine = {{ $machine | quote }}
