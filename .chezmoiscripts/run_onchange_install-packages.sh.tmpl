{{- $groups := .packages.groups -}}
{{- if not (hasKey .packages.machines .machine) -}}
{{-   fail (printf "machine %q is not defined in .chezmoidata/packages.toml" .machine) -}}
{{- end -}}

{{- /* Machine list from the repo, plus per-host extras from chezmoi.toml */ -}}
{{- $names := concat (index .packages.machines .machine) (get . "addPackages" | default list) -}}
{{- $skip := concat (get (get .packages "skip" | default dict) .machine | default list) (get . "skipPackages" | default list) -}}

{{- $allCasks := list -}}
{{- range $groups -}}
{{-   $allCasks = concat $allCasks (get . "cask" | default list) -}}
{{- end -}}

{{- $brew := list -}}
{{- $cask := list -}}
{{- $mas := dict -}}
{{- range $names -}}
{{-   if hasKey $groups . -}}
{{-     $g := index $groups . -}}
{{-     $brew = concat $brew (get $g "brew" | default list) -}}
{{-     $cask = concat $cask (get $g "cask" | default list) -}}
{{-     $mas = merge $mas (get $g "mas" | default dict) -}}
{{-   else if has . $allCasks -}}
{{-     $cask = append $cask . -}}
{{-   else -}}
{{-     $brew = append $brew . -}}
{{-   end -}}
{{- end -}}

{{- range $skip -}}
{{-   $brew = without $brew . -}}
{{-   $cask = without $cask . -}}
{{- end -}}
{{- $brew = $brew | uniq | sortAlpha -}}
{{- $cask = $cask | uniq | sortAlpha -}}

{{- /* "owner/tap/name" -> tap "owner/tap" */ -}}
{{- $taps := list -}}
{{- range concat $brew $cask -}}
{{-   $parts := splitList "/" . -}}
{{-   if eq (len $parts) 3 -}}
{{-     $taps = append $taps (printf "%s/%s" (index $parts 0) (index $parts 1)) -}}
{{-   end -}}
{{- end -}}
{{- $taps = $taps | uniq | sortAlpha -}}

#!/bin/bash
set -euo pipefail

# brew was just installed by the previous script, in a separate process,
# so it may not be on PATH yet in this one.
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -x "$brew_bin" ]; then
    eval "$("$brew_bin" shellenv)"
    break
  fi
done

brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT
cat > "$brewfile" <<'EOF'
{{ range $taps -}}
tap {{ . | quote }}, trusted: true
{{ end -}}
{{ range $brew -}}
brew {{ . | quote }}
{{ end -}}
{{ range $cask -}}
cask {{ . | quote }}
{{ end -}}
{{ range $name, $id := $mas -}}
mas {{ $name | quote }}, id: {{ $id }}
{{ end -}}
EOF

echo "📦 Installing packages..."
brew bundle install --no-upgrade --file="$brewfile"

# brew bundle cleanup resets Homebrew's global trust store to exactly
# what the Brewfile declares as `trusted: true` above, so trust is
# declared in the Brewfile itself rather than via separate `brew trust`
# calls, which cleanup would otherwise wipe out.
brew bundle cleanup --force --file="$brewfile"
